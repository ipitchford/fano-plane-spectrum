ring r = (0,t), (x1,x2,x3,x4,x5,x6), dp; minpoly = t^2+t+2;
ideal I = x2*x4 + x5*x6 + x3 - t*x1^2,
          x1*x4 + x3*x5 + x6 - t*x2^2,
          x2*x5 + x4*x6 + x1 - t*x3^2,
          x1*x2 + x3*x6 + x5 - t*x4^2,
          x2*x3 + x4 + x1*x6 - t*x5^2,
          x3*x4 + x1*x5 + x2 - t*x6^2,
          x4*x5 + x2*x6 + x1*x3 - t;
ideal G = std(I);
printf("over Q(t): dim %s  mult %s", dim(G), mult(G));
poly s = x1+x2+x3+x4+x5+x6+1;
printf("sum of coordinates reduces to zero mod G: %s", reduce(s, G) == 0);
// is the ideal radical along the curve? compare with radical later if needed
quit;
