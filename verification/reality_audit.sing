ring r=0,(x1,x2,x3,x4,x5,x6),dp;
ideal I=x2*x4+x5*x6+x3-2*x1^2,
 x1*x4+x3*x5+x6-2*x2^2,
 x2*x5+x4*x6+x1-2*x3^2,
 x1*x2+x3*x6+x5-2*x4^2,
 x2*x3+x4+x1*x6-2*x5^2,
 x3*x4+x1*x5+x2-2*x6^2,
 x4*x5+x2*x6+x1*x3-2;
ideal G=std(I);
poly S=x1+x2+x3+x4+x5+x6+1;
poly Q=x1^2+x2^2+x3^2+x4^2+x5^2+x6^2+1;
print("SUM AND SUM-SQUARE RESIDUES"); reduce(S,G); reduce(S^2,G); reduce(Q,G);
matrix C=lift(I,ideal(Q));
print("EXACT SUM OF SQUARES CERTIFICATE MULTIPLIERS"); C;
print("CERTIFICATE RESIDUAL"); matrix(I)*C-matrix(ideal(Q));
quit;
