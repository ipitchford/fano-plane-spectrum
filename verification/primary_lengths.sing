LIB "primdec.lib";
ring r=0,(x1,x2,x3,x4,x5,x6),dp;
int a; int i;
for(a=1;a<=2;a++) {
ideal I=x2*x4+x5*x6+x3-a*x1^2,
 x1*x4+x3*x5+x6-a*x2^2,
 x2*x5+x4*x6+x1-a*x3^2,
 x1*x2+x3*x6+x5-a*x4^2,
 x2*x3+x4+x1*x6-a*x5^2,
 x3*x4+x1*x5+x2-a*x6^2,
 x4*x5+x2*x6+x1*x3-a;
list L=primdecGTZ(I);
printf("COMPONENTS %s %s",a,size(L));
for(i=1;i<=size(L);i++) {
 ideal Q=std(L[i][1]);
 ideal P=std(L[i][2]);
 printf("PRIMARY_RADICAL_LENGTH %s %s %s",a,vdim(Q),vdim(P));
 kill Q,P;
}
kill I,L;
}
quit;
